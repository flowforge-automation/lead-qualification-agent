        "messages": {
          "values": [
            {
              "content": "=You are drafting a follow-up email for a HOT LEAD — a qualified prospect ready to move forward. Write a warm, professional, concise email reply to {{ $json.name }} at {{ $json.company }}.\n\nContext on why they qualified as a hot lead:\n{{ $json.reasoning }}\n\nThe email should:\n- Thank them for reaching out\n- Reference their specific need\n- Propose a concrete next step (like a call this week), matching their urgency\n- Sign off as [Your name]\n\nWrite ONLY the email body — no subject line, no explanation, no markdown."
            }
          ]
        },
        "options": {}
